{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TS 6 no longer auto-includes node_modules/@types — pull in the jest
    // globals for the tests/ suites (runtime config in jest.config.js).
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "references": [
    {
      "path": "../../packages/shared"
    },
    {
      "path": "../../packages/design-system"
    }
  ]
}
