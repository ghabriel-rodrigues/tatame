# Database
POSTGRES_USER=tatame
POSTGRES_PASSWORD=tatame_dev
POSTGRES_DB=tatame
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tatame:tatame_dev@localhost:5432/tatame

# Auth
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Payments (spec 006): `simulated` is the only runtime driver in v1;
# `stripe` selects the compile-checked Connect stub (stage-2 swap).
PAYMENTS_PROVIDER=simulated

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend (transactional email)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=no-reply@tatame.app

# Netlify (web deploy)
NETLIFY_AUTH_TOKEN=nfp_xxx
NETLIFY_SITE_ID=xxx

# API
API_PORT=3000
WEB_URL=http://localhost:4200
