#!/bin/sh
# Local CI gate (2026-09-20): pushing red to main stalls the whole deploy
# chain (Render waits on checks; deploy-web is workflow_run-gated), so the
# CI-equivalent runs here first. Enable once per clone with:
#   git config core.hooksPath .githooks
# Skip (emergencies only): git push --no-verify
set -e

# --all: a plain format:check diffs against a LOCAL base and goes quiet on a
# committed main, while CI diffs against the last green run — the whole tree
# is the only base both sides agree on (and it costs seconds).
echo "[pre-push] nx format:check --all"
pnpm nx format:check --all

echo "[pre-push] nx affected -t lint typecheck test build (base origin/main)"
pnpm nx affected -t lint typecheck test build --base origin/main

echo "[pre-push] green — pushing"
