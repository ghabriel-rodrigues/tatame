      "AcceptInviteDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "example": "1996-02-11"
          },
          "dependents": {
            "description": "Guardian (responsável) invites only: minor dependents enrolled with the guardian. Consumed by the enrollment slice.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DependentDto"
            }
          }
        },
        "required": [
          "email",
          "password",
          "fullName"
        ]
      },
      "InviteAcceptResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserSummaryDto"
          },
