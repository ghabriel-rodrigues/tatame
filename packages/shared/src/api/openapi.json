      "ImpersonationGrantResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessExpiresIn": {
            "type": "number",
            "description": "Access token TTL in seconds"
          },
          "refreshToken": {
            "type": "string",
            "description": "Always in the body: the platform refresh cookie stays untouched"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "1-hour absolute cap"
          },
          "academy": {
            "$ref": "#/components/schemas/ImpersonationAcademyDto"
          }
        },
        "required": [
          "accessToken",
          "accessExpiresIn",
          "refreshToken",
          "expiresAt",
          "academy"
        ]
      }
