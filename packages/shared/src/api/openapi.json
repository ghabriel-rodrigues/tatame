            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembershipViewDto"
            }
          },
          "activeMembershipId": {
            "type": "string",
            "format": "uuid"
          },
          "accessToken": {
            "type": "string"
          },
          "accessExpiresIn": {
            "type": "number",
            "description": "Access token TTL in seconds"
          },
          "refreshToken": {
            "type": "string",
            "description": "Always in the body — the client stores it per its platform contract"
          }
        },
        "required": [
          "user",
          "memberships",
          "activeMembershipId",
          "accessToken",
          "accessExpiresIn",
          "refreshToken"
        ]
