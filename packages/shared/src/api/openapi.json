  },
  "info": {
    "title": "Tatame API",
    "description": "Identity surface (spec 001-auth). Errors are RFC 9457 application/problem+json with stable `code`s.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": ""
    },
    {
      "name": "public",
      "description": ""
    },
    {
      "name": "invites",
      "description": ""
    },
    {
      "name": "admin",
      "description": ""
    },
    {
      "name": "platform",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@tatame.dev"
          },
          "password": {
            "type": "string",
            "minLength": 1
          },
          "transport": {
            "type": "string",
            "enum": [
              "cookie",
              "body"
            ],
            "default": "cookie"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "fullName"
        ]
      },
      "MembershipViewDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "academy",
              "platform"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "professor",
              "admin",
              "guardian",
              "owner",
              "support",
              "finance"
            ]
          },
          "tenantId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "academyName": {
            "type": "string",
            "nullable": true
          },
          "academySlug": {
            "type": "string",
            "nullable": true
          },
          "academyStatus": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "role",
          "tenantId",
          "academyName",
          "academySlug",
          "academyStatus",
          "status"
        ]
      },
      "AuthSessionResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserSummaryDto"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembershipViewDto"
            }
          },
          "activeMembershipId": {
            "type": "string",
            "format": "uuid"
          },
          "accessToken": {
            "type": "string"
          },
          "accessExpiresIn": {
            "type": "number",
            "description": "Access token TTL in seconds"
          },
          "refreshToken": {
            "type": "string",
            "description": "Only for `body` transport; web gets the httpOnly cookie"
          }
        },
        "required": [
          "user",
          "memberships",
          "activeMembershipId",
          "accessToken",
          "accessExpiresIn"
        ]
      },
      "MfaChallengeResponseDto": {
        "type": "object",
        "properties": {
          "mfaRequired": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "challengeToken": {
            "type": "string",
            "description": "Short-lived token consumed by POST /auth/login/totp"
          }
        },
        "required": [
          "mfaRequired",
          "challengeToken"
        ]
      },
      "TotpLoginDto": {
        "type": "object",
        "properties": {
          "challengeToken": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "TOTP code or single-use recovery code"
          },
          "transport": {
            "type": "string",
            "enum": [
              "cookie",
              "body"
            ],
            "default": "cookie"
          }
        },
        "required": [
          "challengeToken",
          "code"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Required for body transport; web uses the cookie"
          },
          "transport": {
            "type": "string",
            "enum": [
              "cookie",
              "body"
            ],
            "default": "cookie"
          }
        }
      },
      "TokenPairResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessExpiresIn": {
            "type": "number",
            "description": "Access token TTL in seconds"
          },
          "refreshToken": {
            "type": "string",
            "description": "Only for `body` transport; web gets the httpOnly cookie"
          }
        },
        "required": [
          "accessToken",
          "accessExpiresIn"
        ]
      },
      "SwitchMembershipDto": {
        "type": "object",
        "properties": {
          "membershipId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "membershipId"
        ]
      },
      "SwitchMembershipResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessExpiresIn": {
            "type": "number",
            "description": "Access token TTL in seconds"
          },
          "activeMembershipId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "accessToken",
          "accessExpiresIn",
          "activeMembershipId"
        ]
      },
      "MeUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "locale": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "phone",
          "avatarUrl",
          "locale"
        ]
      },
      "MeAcademyDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "logoUrl": {
            "type": "string",
            "nullable": true
          },
          "theme": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "White-label 3-color brand input (deep/vibrant/accent) when configured"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "status",
          "logoUrl",
          "theme"
        ]
      },
      "MeImpersonationDto": {
        "type": "object",
        "properties": {
          "isImpersonated": {
            "type": "boolean"
          },
          "impersonatorUserId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "isImpersonated"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/MeUserDto"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembershipViewDto"
            }
          },
          "activeMembershipId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Null during impersonation"
          },
          "activeRole": {
            "type": "string",
            "enum": [
              "student",
              "professor",
              "admin",
              "guardian",
              "owner",
              "support",
              "finance"
            ]
          },
          "academy": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/MeAcademyDto"
              }
            ]
          },
          "permissions": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "impersonation": {
            "$ref": "#/components/schemas/MeImpersonationDto"
          }
        },
        "required": [
          "user",
          "memberships",
          "activeMembershipId",
          "activeRole",
          "academy",
          "permissions",
          "impersonation"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "ForgotPasswordResponseDto": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "accepted"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "TotpSetupResponseDto": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "description": "Base32 provisioning secret"
          },
          "otpauthUri": {
            "type": "string",
            "description": "otpauth:// URI for authenticator apps"
          }
        },
        "required": [
          "secret",
          "otpauthUri"
        ]
      },
      "TotpEnableDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Code from the authenticator app"
          }
        },
        "required": [
          "code"
        ]
      },
      "TotpEnableResponseDto": {
        "type": "object",
        "properties": {
          "recoveryCodes": {
            "description": "Single-use recovery codes — shown exactly once",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "recoveryCodes"
        ]
      },
      "InviteAcademyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "logoUrl": {
            "type": "string",
            "nullable": true
          },
          "theme": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "White-label 3-color brand input (deep/vibrant/accent) when configured"
          }
        },
        "required": [
          "name",
          "slug",
          "logoUrl",
          "theme"
        ]
      },
