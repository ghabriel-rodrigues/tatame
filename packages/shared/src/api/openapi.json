      "CreateInviteDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "student",
              "guardian"
            ]
          },
          "classId": {
            "type": "string",
            "format": "uuid",
            "description": "Turma binding (class slice)"
          },
          "academyPlanId": {
            "type": "string",
            "format": "uuid",
            "description": "Academy plan binding (billing slice)"
          },
          "maxUses": {
            "type": "number",
            "minimum": 1,
            "description": "Absent = unlimited until expiry"
          }
