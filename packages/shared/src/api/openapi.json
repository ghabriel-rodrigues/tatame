          },
          "label": {
            "type": "string",
            "description": "PT-BR handoff label (admin screen copy)"
          },
          "defaultAllowed": {
            "type": "boolean"
          },
          "allowed": {
            "type": "boolean"
          }
        },
        "required": [
          "role",
          "key",
          "label",
          "defaultAllowed",
          "allowed"
        ]
      },
      "PermissionMatrixResponseDto": {
        "type": "object",
        "properties": {
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResolvedPermissionDto"
            }
          }
        },
        "required": [
          "permissions"
        ]
      },
      "PermissionEntryDto": {
        "type": "object",
        "properties": {
