{
  "$description": "Tatame / Lumira design tokens — canonical source (W3C DTCG). Converted once from tokens/reference/colors_and_type.css (frozen) plus the prototypes' runtime-only tokens (applyPalette/applyTema). Light values are the default; dark-mode overrides live in $extensions[\"com.tatame\"].dark per token (the applyTema() remix table, plus — for the white-label brand tints anchored on the symbolic W — the values of derivePalette(TATAME_DEFAULT_BRAND,'dark'), which the runtime white-label overlay recomputes for branded tenants). Belt tokens are static and brand-independent: never derived, never dark-remixed (ds-04).",
  "color": {
    "$type": "color",
    "purple": {
      "$description": "Deep purple brand scale. 700 = deep brand input, 500 = vibrant brand input under white-label. W-anchored tints (50-400) carry dark values from derivePalette(default,'dark').",
      "50": { "$value": "#F8F2FE", "$extensions": { "com.tatame": { "dark": "#292143" } } },
      "100": { "$value": "#EEDDFB", "$extensions": { "com.tatame": { "dark": "#312450" } } },
      "200": { "$value": "#DEBFF8", "$extensions": { "com.tatame": { "dark": "#3D2966" } } },
      "300": { "$value": "#C695F4", "$extensions": { "com.tatame": { "dark": "#512F86" } } },
      "400": { "$value": "#A968F0", "$extensions": { "com.tatame": { "dark": "#6C37B6" } } },
      "500": { "$value": "#8B3DEB", "$description": "primary vibrant purple" },
      "600": { "$value": "#6B2DBA" },
      "700": { "$value": "#4F2389", "$description": "primary deep purple" },
      "800": { "$value": "#3B1A66" },
      "900": { "$value": "#2A1248" },
      "950": { "$value": "#1A0B2E", "$description": "darkest, near-black plum" }
    },
    "pink": {
      "$description": "Purple-leaning rose accent scale. 500 = accent brand input under white-label.",
      "50": { "$value": "#FEF5F9", "$extensions": { "com.tatame": { "dark": "#2F2240" } } },
      "100": { "$value": "#FDE9F3", "$extensions": { "com.tatame": { "dark": "#3B2748" } } },
      "200": { "$value": "#FBD2E8", "$extensions": { "com.tatame": { "dark": "#553057" } } },
      "300": { "$value": "#F7AED8", "$extensions": { "com.tatame": { "dark": "#7A3C6D" } } },
      "400": { "$value": "#F285C5", "$extensions": { "com.tatame": { "dark": "#B04B8C" } } },
      "500": { "$value": "#EC5BAE", "$description": "primary pink accent" },
      "600": { "$value": "#D63E96" },
      "700": { "$value": "#B8267A" }
    },
    "gray": {
      "$description": "Warm-cool neutral scale, never pure black. Dark values from applyTema().",
      "50": { "$value": "#FAF9FC", "$extensions": { "com.tatame": { "dark": "#241E3A" } } },
      "100": { "$value": "#F2F0F6", "$extensions": { "com.tatame": { "dark": "#2E2748" } } },
      "200": { "$value": "#E6E3EC", "$extensions": { "com.tatame": { "dark": "#3D3560" } } },
      "300": { "$value": "#D2CED9", "$extensions": { "com.tatame": { "dark": "#4D4478" } } },
      "400": { "$value": "#B3ADBC", "$extensions": { "com.tatame": { "dark": "#7E7699" } } },
      "500": { "$value": "#8E8799" },
      "600": { "$value": "#6B6378", "$extensions": { "com.tatame": { "dark": "#C7C0DC" } } },
      "700": { "$value": "#4A4258" },
      "800": { "$value": "#2E2839" },
      "900": { "$value": "#1C1726" },
      "950": { "$value": "#0F0B17" }
    },
    "white": { "$value": "#FFFFFF" },
    "ink": {
      "$description": "Readable brand ink — runtime-only in the prototypes (--purple-ink/--pink-ink), promoted to first-class mode-conditional tokens (ds-01). Recomputed by derivePalette under white-label.",
      "purple": {
        "$value": "{color.purple.700}",
        "$extensions": { "com.tatame": { "dark": "#B08AF7" } }
      },
      "pink": {
        "$value": "#A83C78",
        "$description": "mix(accent 64% #3B0A24) with the default accent",
        "$extensions": { "com.tatame": { "dark": "#FAA1CE" } }
      }
    },
    "success": {
      "100": { "$value": "#D9F2E5", "$extensions": { "com.tatame": { "dark": "#163526" } } },
      "500": { "$value": "#2BB673" }
    },
    "warning": {
      "100": { "$value": "#FCEBCC", "$extensions": { "com.tatame": { "dark": "#3A2F14" } } },
      "500": { "$value": "#F0A020" }
    },
    "danger": {
      "100": { "$value": "#FBDDE2", "$extensions": { "com.tatame": { "dark": "#3A1B22" } } },
      "500": { "$value": "#E04359" }
    },
    "info": {
      "100": { "$value": "#DDE5FD" },
      "500": { "$value": "#5B7DF5" }
    },
    "fg": {
      "$description": "Foreground (text + icons). Dark literals from applyTema().",
      "1": { "$value": "{color.purple.950}", "$description": "primary text", "$extensions": { "com.tatame": { "dark": "#F2EFFA" } } },
      "2": { "$value": "{color.purple.800}", "$description": "secondary text", "$extensions": { "com.tatame": { "dark": "#D6D0E8" } } },
      "3": { "$value": "{color.gray.600}", "$description": "muted, captions, helper text", "$extensions": { "com.tatame": { "dark": "#A79FC2" } } },
      "4": { "$value": "{color.gray.500}", "$description": "placeholders, disabled", "$extensions": { "com.tatame": { "dark": "#7E7699" } } },
      "on-color": { "$value": "{color.white}", "$description": "on purple/pink fills" }
    },
    "bg": {
      "app": { "$value": "{color.gray.50}", "$description": "app canvas", "$extensions": { "com.tatame": { "dark": "#141021" } } },
      "surface": { "$value": "{color.white}", "$description": "cards, sheets", "$extensions": { "com.tatame": { "dark": "#1D1830" } } },
      "sunken": { "$value": "{color.gray.100}", "$description": "inset wells" },
      "overlay": { "$value": "rgba(26, 11, 46, 0.55)", "$description": "dialog scrim" }
    },
    "brand": {
      "1": { "$value": "{color.purple.700}", "$description": "primary fill" },
      "2": { "$value": "{color.purple.500}", "$description": "secondary fill" },
      "accent": { "$value": "{color.pink.500}" },
      "tint": { "$value": "{color.purple.50}", "$description": "subtle wash background" }
    },
    "border": {
      "1": { "$value": "{color.gray.200}", "$description": "default border", "$extensions": { "com.tatame": { "dark": "#2E2748" } } },
      "2": { "$value": "{color.gray.300}", "$description": "hover/focus rest", "$extensions": { "com.tatame": { "dark": "#3D3560" } } },
      "strong": { "$value": "{color.purple.700}" }
    },
    "belt": {
      "$description": "Jiu-jitsu belt colors (ds-04). Static and brand-independent: never in palette-recipe.json, identical hex in both modes. belt.purple incidentally equals default purple-600 but stays a literal so white-label can never repaint belts.",
      "white": { "$value": "#EDEAE2" },
      "gray": { "$value": "#9A9AA2" },
      "yellow": { "$value": "#E8C93D" },
      "orange": { "$value": "#E8833D" },
      "green": { "$value": "#3D8B4F" },
      "blue": { "$value": "#1E5CB3" },
      "purple": { "$value": "#6B2DBA" },
      "brown": { "$value": "#6B4A2D" },
      "black": { "$value": "#17141F" },
      "red": { "$value": "#B3261E" },
      "tip": { "$value": "#17141F", "$description": "default ponteira" },
      "stripe": { "$value": "#FFFFFF", "$description": "degree stripes" },
      "outline": { "$value": "rgba(26, 11, 46, 0.14)", "$description": "hairline inset border keeping light belts visible" }
    }
  },
  "focus": {
    "ring": {
      "$type": "shadow",
      "$description": "Focus ring: 0 0 0 3px purple-500 @ 40%. CSS emits the Lumira color-mix string; native targets consume width/opacity + the purple-500 reference.",
      "$value": {
        "color": "{color.purple.500}",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "3px",
        "alpha": 0.4
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Quicksand", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
      "body": { "$value": ["Quicksand", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
      "mono": { "$value": ["ui-monospace", "SF Mono", "JetBrains Mono", "Menlo", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "$description": "Quicksand ships 300-700",
      "light": { "$value": 300 },
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "text": {
    "size": {
      "$type": "dimension",
      "$description": "1.200 minor third scale",
      "2xs": { "$value": "11px" },
      "xs": { "$value": "12px" },
      "sm": { "$value": "14px" },
      "base": { "$value": "16px" },
      "md": { "$value": "18px" },
      "lg": { "$value": "20px" },
      "xl": { "$value": "24px" },
      "2xl": { "$value": "30px" },
      "3xl": { "$value": "36px" },
      "4xl": { "$value": "48px" },
      "5xl": { "$value": "60px" },
      "6xl": { "$value": "72px" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.15 },
      "snug": { "$value": 1.3 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.65 }
    },
    "tracking": {
      "$type": "number",
      "$description": "Letter spacing in em. Quicksand reads better slightly tight on display sizes. RN consumers multiply by fontSize (letterSpacing is px in RN).",
      "tight": { "$value": -0.02 },
      "normal": { "$value": 0 },
      "wide": { "$value": 0.04 },
      "caps": { "$value": 0.08 }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "24": { "$value": "96px" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "generous & rounded brand",
    "xs": { "$value": "6px" },
    "sm": { "$value": "10px" },
    "md": { "$value": "14px" },
    "lg": { "$value": "20px" },
    "xl": { "$value": "28px" },
    "2xl": { "$value": "36px" },
    "pill": { "$value": "999px" }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Soft, purple-tinted. Structured per DTCG; each platform maps per the ds-01 degradation policy (CSS box-shadow / Compose elevation approximation / iOS+RN shadow params).",
    "xs": { "$value": [{ "color": "rgba(42, 18, 72, 0.06)", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }] },
    "sm": { "$value": [{ "color": "rgba(42, 18, 72, 0.08)", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "0px" }] },
    "md": { "$value": [{ "color": "rgba(42, 18, 72, 0.10)", "offsetX": "0px", "offsetY": "8px", "blur": "20px", "spread": "0px" }] },
    "lg": { "$value": [{ "color": "rgba(42, 18, 72, 0.14)", "offsetX": "0px", "offsetY": "18px", "blur": "40px", "spread": "0px" }] },
    "xl": { "$value": [{ "color": "rgba(42, 18, 72, 0.18)", "offsetX": "0px", "offsetY": "30px", "blur": "60px", "spread": "0px" }] },
    "glow": { "$value": [{ "color": "rgba(139, 61, 235, 0.35)", "offsetX": "0px", "offsetY": "8px", "blur": "32px", "spread": "0px" }], "$description": "primary-CTA glow mixin only" },
    "inset": { "$value": [{ "color": "rgba(42, 18, 72, 0.06)", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "inset": true }] }
  },
  "glass": {
    "$description": "Liquid glass raw ingredients (ds-01 degradation policy: each platform assembles its own composite — backdrop-filter on web, expo-blur on RN, haze modifier on Compose, custom material on SwiftUI).",
    "bg": { "$type": "color", "$value": "rgba(255, 255, 255, 0.55)" },
    "bg-deep": { "$type": "color", "$value": "rgba(248, 242, 254, 0.65)", "$extensions": { "com.tatame": { "dark": "rgba(26, 21, 44, 0.92)" } } },
    "border": { "$type": "color", "$value": "rgba(255, 255, 255, 0.7)", "$extensions": { "com.tatame": { "dark": "rgba(255, 255, 255, 0.14)" } } },
    "stroke": { "$type": "color", "$value": "rgba(139, 61, 235, 0.18)" },
    "blur": { "$type": "dimension", "$value": "20px" },
    "blur-strong": { "$type": "dimension", "$value": "24px", "$description": "heavier blur tier for deep sheets/dialogs (new token, not in the frozen CSS)" },
    "saturation": { "$type": "number", "$value": 1.8, "$description": "CSS emits 180%" },
    "shine": {
      "$type": "gradient",
      "$description": "linear-gradient 135deg shine overlay",
      "$value": {
        "angle": 135,
        "stops": [
          { "color": "rgba(255, 255, 255, 0.7)", "position": 0 },
          { "color": "rgba(255, 255, 255, 0.15)", "position": 0.4 },
          { "color": "rgba(255, 255, 255, 0)", "position": 1 }
        ]
      }
    },
    "shadow": {
      "$type": "shadow",
      "$value": [
        { "color": "rgba(42, 18, 72, 0.15)", "offsetX": "0px", "offsetY": "8px", "blur": "32px", "spread": "0px" },
        { "color": "rgba(255, 255, 255, 0.9)", "offsetX": "0px", "offsetY": "1px", "blur": "0px", "spread": "0px", "inset": true },
        { "color": "rgba(139, 61, 235, 0.08)", "offsetX": "0px", "offsetY": "-1px", "blur": "0px", "spread": "0px", "inset": true }
      ]
    }
  },
  "motion": {
    "ease": {
      "$type": "cubicBezier",
      "out": { "$value": [0.22, 1, 0.36, 1] },
      "in": { "$value": [0.55, 0, 1, 0.45] },
      "spring": { "$value": [0.34, 1.56, 0.64, 1] }
    },
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" }
    }
  }
}
