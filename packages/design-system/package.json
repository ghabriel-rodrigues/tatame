{
  "name": "@tatame/design-system",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./native": {
      "types": "./src/native/index.ts",
      "import": "./src/native/index.ts",
      "default": "./src/native/index.ts"
    },
    "./tokens": {
      "types": "./build/web/tokens.ts",
      "import": "./build/web/tokens.ts",
      "default": "./build/web/tokens.ts"
    },
    "./tokens.css": "./build/web/tokens.css",
    "./tokens/native": {
      "types": "./build/native/tokens.ts",
      "import": "./build/native/tokens.ts",
      "default": "./build/native/tokens.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "tokens": "node tokens/build.mjs",
    "tokens:fixtures": "node --experimental-strip-types scripts/generate-fixtures.mjs"
  },
  "peerDependencies": {
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11",
    "@fontsource/quicksand": "*",
    "@mui/material": ">=6",
    "expo-blur": "*",
    "expo-linear-gradient": "*",
    "lucide-react-native": "*",
    "react": ">=19",
    "react-native": "*",
    "react-native-reanimated": "*",
    "react-native-svg": "*"
  },
  "peerDependenciesMeta": {
    "@emotion/react": {
      "optional": true
    },
    "@emotion/styled": {
      "optional": true
    },
    "@fontsource/quicksand": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    },
    "expo-blur": {
      "optional": true
    },
    "expo-linear-gradient": {
      "optional": true
    },
    "lucide-react-native": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "nx": {
    "name": "design-system",
    "targets": {
      "tokens": {
        "cache": true,
        "inputs": [
          "{projectRoot}/tokens/tokens.json",
          "{projectRoot}/tokens/palette-recipe.json",
          "{projectRoot}/tokens/build.mjs",
          "{projectRoot}/tokens/lib/*.mjs"
        ],
        "outputs": [
          "{projectRoot}/build",
          "{projectRoot}/src/theme/palette-recipe.data.ts"
        ]
      }
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/quicksand": "^5.3.0",
    "@mui/material": "^9.2.0",
    "expo-blur": "^57.0.2",
    "expo-linear-gradient": "^57.0.1",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-native": "^0.86.2",
    "react-native-reanimated": "^4.5.1",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "0.10.1",
    "style-dictionary": "^4.4.0"
  }
}
